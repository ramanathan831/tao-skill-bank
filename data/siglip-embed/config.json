{
  "network_arch": "siglip-embed",
  "container_image": "nvcr.io/nvidian/iva/embed:latest",
  "required_credentials": [],
  "actions": {
    "embed": {
      "command": "accelerate launch --num_processes {num_gpus} image_embeddings.py",
      "mode": "args",
      "num_gpus": "{num_gpus}",
      "inputs": {
        "input-parquet": {
          "type": "file"
        }
      },
      "outputs": {
        "output-parquet": {
          "type": "file"
        }
      },
      "args": {
        "input-parquet": "{input_parquet}",
        "output-parquet": "{output_parquet}",
        "model": "SigLIP"
      },
      "defaults": {
        "num_gpus": 1
      }
    }
  },
  "tags": [
    "embedding",
    "similarity",
    "siglip",
    "image"
  ],
  "description": "SigLIP image embedding model for computing visual similarity in mining pipelines."
}
