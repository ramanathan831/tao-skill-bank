{
  "network_arch": "vcn-merge-csv",
  "container_image": "nvcr.io/nvidian/iva/smart_data_augmentation",
  "actions": {
    "merge": {
      "command": "python /tmp/user_script.py",
      "mode": "args",
      "inputs": {
        "mined-parquet": {"type": "file"},
        "source-pool-parquet": {"type": "file"}
      },
      "outputs": {
        "output-csv": {"type": "file"}
      }
    }
  },
  "tags": ["merge", "csv", "vcn", "aoi", "training-data"],
  "description": "Merge mined samples with previous training CSV for Visual ChangeNet retraining."
}
