{
  "network_arch": "nim-embedding",
  "container_image": "nvcr.io/nvidian/iva/embed:latest",
  "gpu_spec_key": null,
  "actions": {
    "embed": {
      "command": "python video_embeddings.py",
      "mode": "args",
      "args": {
        "input-parquet": "{input_parquet}",
        "output-parquet": "{output_parquet}",
        "nim-endpoint": "{nim_endpoint}"
      },
      "inputs": {"input-parquet": {"type": "file"}},
      "outputs": {"output-parquet": {"type": "file"}}
    }
  }
}
