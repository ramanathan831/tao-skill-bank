{
  "name": "deft-vcn-aoi",
  "type": "workflow",
  "description": "VCN AOI SDA pipeline: mining-based iterative data improvement for visual change detection. Each iteration identifies failure cases, mines similar samples from a source pool using SigLIP embeddings + k-NN, merges them into training data, and retrains.",
  "prerequisites": {
    "required": [
      {
        "name": "kpi_dataset_uri",
        "description": "S3 URI of the KPI/validation dataset (must contain CSV annotations and images/ folder)"
      },
      {
        "name": "platform",
        "description": "Compute backend (lepton)"
      },
      {
        "name": "mining_source_csv",
        "description": "S3 URI of the source pool CSV for mining (large unlabeled/weakly-labeled dataset)"
      },
      {
        "name": "mining_source_images",
        "description": "S3 URI of the source pool images directory"
      }
    ],
    "optional": [
      {
        "name": "train_dataset_uri",
        "description": "Initial training dataset URI (triggers SFT before the SDA loop)"
      },
      {
        "name": "init_checkpoint",
        "description": "Initial model checkpoint (pretrained VCN weights)"
      },
      {
        "name": "iteration_count",
        "description": "Number of SDA iterations to run (default: 3)"
      },
      {
        "name": "continual_model",
        "description": "Chain checkpoints across iterations (default: true)"
      },
      {
        "name": "continual_dataset",
        "description": "Accumulate training data across iterations (default: true)"
      },
      {
        "name": "topn",
        "description": "Number of nearest neighbors per query in k-NN mining (default: 5)"
      },
      {
        "name": "knn_metric",
        "description": "Distance metric for k-NN mining (default: cosine)"
      },
      {
        "name": "min_recall",
        "description": "Minimum NO_PASS recall for threshold optimization (default: 1.0)"
      }
    ]
  },
  "iteration_defaults": {
    "count": 3,
    "continual_model": true,
    "continual_dataset": true,
    "topn": 5,
    "knn_metric": "cosine",
    "min_recall": 1.0
  },
  "stages": {
    "init": [
      {
        "name": "zero_shot_inference",
        "action": "inference",
        "skill": "visual-changenet",
        "type": "gpu"
      },
      {
        "name": "threshold_optimization",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/compute_vcn_optimal_threshold.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/init/inference",
          "output-json": "{storage_root}/init/threshold.json",
          "min-recall": "{min_recall}"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          }
        },
        "outputs": {
          "output-json": {
            "type": "file"
          }
        }
      },
      {
        "name": "zero_shot_eval",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/analyze_vcn_inference_gaps.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/init/inference",
          "threshold-json": "{storage_root}/init/threshold.json",
          "kpi-csv": "{kpi_dataset_uri}",
          "output-metrics": "{storage_root}/init/metrics.json",
          "output-gaps": "{storage_root}/init/gaps.parquet",
          "mode": "eval-only"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          },
          "threshold-json": {
            "type": "file"
          },
          "kpi-csv": {
            "type": "file"
          }
        },
        "outputs": {
          "output-metrics": {
            "type": "file"
          }
        }
      },
      {
        "name": "sft_training",
        "action": "train",
        "skill": "visual-changenet",
        "type": "gpu",
        "conditional": "train_dataset_uri provided"
      },
      {
        "name": "sft_inference",
        "action": "inference",
        "skill": "visual-changenet",
        "type": "gpu",
        "conditional": "after sft_training"
      },
      {
        "name": "sft_threshold",
        "type": "cpu",
        "conditional": "after sft_inference",
        "script": "applications/deft-vcn-aoi/scripts/compute_vcn_optimal_threshold.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/init/sft/inference",
          "output-json": "{storage_root}/init/sft_threshold.json",
          "min-recall": "{min_recall}"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          }
        },
        "outputs": {
          "output-json": {
            "type": "file"
          }
        }
      },
      {
        "name": "sft_eval",
        "type": "cpu",
        "conditional": "after sft_threshold",
        "script": "applications/deft-vcn-aoi/scripts/analyze_vcn_inference_gaps.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/init/sft/inference",
          "threshold-json": "{storage_root}/init/sft_threshold.json",
          "kpi-csv": "{kpi_dataset_uri}",
          "output-metrics": "{storage_root}/init/sft_metrics.json",
          "output-gaps": "{storage_root}/init/sft_gaps.parquet",
          "mode": "eval-only"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          },
          "threshold-json": {
            "type": "file"
          },
          "kpi-csv": {
            "type": "file"
          }
        },
        "outputs": {
          "output-metrics": {
            "type": "file"
          }
        }
      }
    ],
    "iteration": [
      {
        "name": "gap_analysis",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/analyze_vcn_inference_gaps.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{prev_storage_root}/inference",
          "threshold-json": "{prev_storage_root}/threshold.json",
          "kpi-csv": "{kpi_dataset_uri}",
          "output-metrics": "{storage_root}/metrics.json",
          "output-gaps": "{storage_root}/gaps/gaps.parquet",
          "mode": "gap-analysis"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          },
          "threshold-json": {
            "type": "file"
          },
          "kpi-csv": {
            "type": "file"
          }
        },
        "outputs": {
          "output-metrics": {
            "type": "file"
          },
          "output-gaps": {
            "type": "file"
          }
        }
      },
      {
        "name": "source_pool_expansion",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/build_vcn_source_pool.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "gaps-parquet": "{storage_root}/gaps/gaps.parquet",
          "source-csv": "{mining_source_csv}",
          "source-images-dir": "{mining_source_images}",
          "output-target-parquet": "{storage_root}/embeddings/target_queries.parquet",
          "output-source-parquet": "{storage_root}/embeddings/source_pool.parquet"
        },
        "inputs": {
          "gaps-parquet": {
            "type": "file"
          },
          "source-csv": {
            "type": "file"
          }
        },
        "outputs": {
          "output-target-parquet": {
            "type": "file"
          },
          "output-source-parquet": {
            "type": "file"
          }
        }
      },
      {
        "name": "embed_target",
        "type": "gpu",
        "action": "embed",
        "skill": "siglip-embed",
        "extra_args": {
          "input_parquet": "{storage_root}/embeddings/target_queries.parquet",
          "output_parquet": "{storage_root}/embeddings/target_embeddings.parquet"
        }
      },
      {
        "name": "embed_source",
        "type": "gpu",
        "action": "embed",
        "skill": "siglip-embed",
        "extra_args": {
          "input_parquet": "{storage_root}/embeddings/source_pool.parquet",
          "output_parquet": "{storage_root}/embeddings/source_embeddings.parquet"
        }
      },
      {
        "name": "knn_mining",
        "type": "gpu",
        "action": "mine",
        "skill": "knn-mining",
        "extra_args": {
          "source_parquet": "{storage_root}/embeddings/source_embeddings.parquet",
          "target_parquet": "{storage_root}/embeddings/target_embeddings.parquet",
          "output_parquet": "{storage_root}/mining/mined_pairs.parquet"
        }
      },
      {
        "name": "merge_training_csv",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/finalize_vcn_train_csv.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "mined-parquet": "{storage_root}/mining/mined_pairs.parquet",
          "source-pool-parquet": "{storage_root}/embeddings/source_pool.parquet",
          "prev-train-csv": "{prev_train_csv}",
          "output-csv": "{storage_root}/training_data/annotations.csv"
        },
        "inputs": {
          "mined-parquet": {
            "type": "file"
          },
          "source-pool-parquet": {
            "type": "file"
          }
        },
        "outputs": {
          "output-csv": {
            "type": "file"
          }
        }
      },
      {
        "name": "training",
        "type": "gpu",
        "action": "train",
        "skill": "visual-changenet"
      },
      {
        "name": "inference",
        "type": "gpu",
        "action": "inference",
        "skill": "visual-changenet"
      },
      {
        "name": "threshold_optimization",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/compute_vcn_optimal_threshold.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/inference",
          "output-json": "{storage_root}/threshold.json",
          "min-recall": "{min_recall}"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          }
        },
        "outputs": {
          "output-json": {
            "type": "file"
          }
        }
      },
      {
        "name": "evaluation",
        "type": "cpu",
        "script": "applications/deft-vcn-aoi/scripts/analyze_vcn_inference_gaps.py",
        "image": "nvcr.io/nvidian/iva/smart_data_augmentation",
        "args": {
          "inference-results": "{storage_root}/inference",
          "threshold-json": "{storage_root}/threshold.json",
          "kpi-csv": "{kpi_dataset_uri}",
          "output-metrics": "{storage_root}/eval_metrics.json",
          "output-gaps": "{storage_root}/eval_gaps.parquet",
          "mode": "eval-only"
        },
        "inputs": {
          "inference-results": {
            "type": "folder"
          },
          "threshold-json": {
            "type": "file"
          },
          "kpi-csv": {
            "type": "file"
          }
        },
        "outputs": {
          "output-metrics": {
            "type": "file"
          }
        }
      }
    ]
  },
  "tags": [
    "pcb",
    "aoi",
    "defect",
    "changenet",
    "mining",
    "deft",
    "sda",
    "visual-inspection"
  ]
}
