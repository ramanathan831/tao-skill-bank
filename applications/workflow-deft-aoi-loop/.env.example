# workflow-deft-aoi-loop — credentials template.
#
# Copy this file to <workspace>/.env and fill in values:
#   cp .env.example <workspace>/.env
#   # Edit <workspace>/.env and fill in values.
#
# The agent sources <workspace>/.env at the start of Pre-Flight.
# Variables already exported in your shell take precedence.

# === Container registry (NGC) ===
# Different NGC orgs gate different image prefixes; each prefix needs the
# matching key. Get keys at https://ngc.nvidia.com → Setup → API Key
# (request one per org you need).
#
# Maps to `nvcr.io/nvstaging/tao/*` — TAO Toolkit & Cosmos images:
#   tao-toolkit-pyt, tao-toolkit-deploy, tao-toolkit-ds, cosmos_rl,
#   cosmos-predict, cosmos-embed.
export NGC_API_KEY_TAO=""
#
# Maps to `nvcr.io/nv-metropolis-dev/*` — Metropolis SDG images:
#   metropolis-sdg/cosmos-anomalygen (used by the AnomalyGen stages).
export NGC_API_KEY_METROPOLIS_DEV=""
#
# Optional fallback. Used to pull any nvcr.io image whose org-specific key
# above is unset (e.g. `nvcr.io/nvidian/iva/*` for the mining container).
# Leave empty unless you have a single key with multi-org read access.
export NGC_API_KEY=""

# === HuggingFace ===
# Required: Pre-Flight downloads model weights from HuggingFace on your
# behalf into augmentation/anomalygen/base_checkpoints/ (cached between
# runs; one-time ~80 GB for 2B SDG, ~140 GB if 14B is included).
# Models pulled:
#   - ChangeNet backbone     nvidia/C-RADIOv2-B
#   - SDG diffusion          nvidia/Cosmos-Predict2-2B-Text2Image (+ -14B-)
#   - Text encoder           google-t5/t5-large (or t5-11b)
#   - Eval embeddings        nvidia/C-RADIO-V3
#   - nn_score / mnn_score   facebook/dinov2-large
#   - AMP segmentation       facebook/sam2
#   - AMP captioning         Qwen/Qwen3-VL-4B-Instruct
#   - k-NN mining            google/siglip-base-patch16-224
# Get a token at https://huggingface.co/settings/tokens (read access is enough).
export HF_TOKEN=""
