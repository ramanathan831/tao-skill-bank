{
  "skill": "tao-hf-finetune",
  "skill_path": "{skill_dir}",
  "credentials": [
    "HF_TOKEN",
    "WANDB_API_KEY",
    "WANDB_PROJECT"
  ],
  "environment": "Host requires NVIDIA GPU + Docker + nvidia-container-toolkit. Container is NGC PyTorch (auto-selected by the skill from the NVIDIA support matrix). Tao-hf-finetune is local-only — it builds a Docker image, runs train/eval/infer inside it, then pushes the trained checkpoint to HF Hub. Each eval generates an isolated project under output_dir; no shared state. Credentials are sourced from ~/.skill-eval-credentials. WANDB_PROJECT defaults to 'tao-hf-finetune-eval' when unset. HF_TOKEN must have write scope so push_to_hub can resolve <whoami>/<short>-finetuned. The skill will reject the run if AutoConfig fails or the dataset is gated/script-based — see references/compat-workarounds.md.",
  "tier_definitions": {
    "T1_pipeline_functional": {
      "name": "Generates a functional pipeline",
      "description": "After Step 4 of the skill, the project directory has all expected files (config.yaml, Dockerfile, requirements.txt, prepare_data.py, train.py, run_eval.py, infer.py, optional merge_lora.py), the Docker image builds successfully, and the 1-step smoke test passes (finite loss, grad_norm > 0).",
      "success_criteria": [
        "output_dir/config.yaml exists with model_id, dataset_id, task, ngc_image, applicable_workarounds, research_sources",
        "output_dir/{Dockerfile,requirements.txt,prepare_data.py,train.py,run_eval.py,infer.py} all exist",
        "docker build -t run-<short>:latest . returns exit 0",
        "logs/smoke.log shows finite loss and grad_norm > 0 at step 1",
        "preflight summary printed with no blank fields"
      ]
    },
    "T2_pipeline_completes": {
      "name": "Post-training plumbing validates on a short budget",
      "description": "Run the SHORT training budget defined in `t2_smoke_config` (a few hundred train images, `max_steps` cap — far short of a full epoch on the real configured data) for the SOLE purpose of producing a real checkpoint to test the post-training plumbing against. T2 then validates that every phase past training fires correctly: baseline eval, post-train eval, 5 inference samples, HF Hub push, rerun-skill emission. Convergence quality and final accuracy are NOT graded at T2 — for a research-driven skill, loss-trend checks are largely tautological (anything that crashes is caught by T1; anything that converges to a worse minimum looks the same as anything that converges well over 30-60 steps). The discriminating signal here is the plumbing: do the downstream scripts actually run end-to-end against a real checkpoint? Final accuracy is graded at T3.",
      "success_criteria": [
        "training ran with the t2_smoke_config knobs (NOT the full configured n_train/n_epochs) and finished without NaN/Inf loss or crash",
        "checkpoints/final/ (or checkpoints/merged/ for LoRA) exists with model weights and is loadable via from_pretrained()",
        "reports/baseline_results.json exists (unless skip_baseline: true) with a numeric value for the task's primary metric — proves run_eval.py works against the pretrained checkpoint",
        "reports/eval_results.json exists with a numeric value for the task's primary metric — proves run_eval.py works against the trained checkpoint (value can be poor at T2; only existence + numeric type checked)",
        "reports/inference_samples/ contains 5 sample triples (input + overlay + meta.json) — proves infer.py works",
        "HF Hub repo exists at the resolved URL with weights + model card + results/ subfolder — proves push_to_hub plumbing (auth, repo creation, model card writing, results upload)",
        "<output_dir>/skills/run-<short>/SKILL.md exists with no literal <placeholder> strings — proves rerun-skill emission and templating",
        "the rerun skill's commands reference real paths (the just-created checkpoint, the dataset_id, the resolved HF repo) — not template variables"
      ]
    },
    "T3_paper_accuracy": {
      "name": "P1 — Reproduces ballpark paper accuracy",
      "description": "Run the FULL configured training budget (`n_train`, `n_eval`, `n_epochs` from the eval entry — NOT the t2_smoke_config knobs) and check the post-fine-tune primary metric is within the per-eval tolerance of the model's paper number. T3 is the only tier that requires a full-length training run.",
      "success_criteria": [
        "training used the eval's full configured n_train / n_eval / n_epochs (NOT the T2 smoke knobs)",
        "post-train primary metric ≥ tier_threshold (per eval)",
        "post-train metric strictly improves on baseline by at least min_improvement (per eval)",
        "metric value is recorded in reports/eval_results.json AND in the pushed HF Hub model card"
      ],
      "priority": "P1 — failure here does NOT fail T1/T2; reported separately."
    }
  },
  "evals": [
    {
      "id": "tao-hf-finetune/convnextv2-tiny-food101",
      "difficulty": "medium",
      "task": "image-classification",
      "model_id": "facebook/convnextv2-tiny-1k-224",
      "dataset_id": "food101",
      "n_train": 6000,
      "n_eval": 1500,
      "n_epochs": 3,
      "max_time_minutes": 60,
      "t2_smoke_config": {
        "n_train": 200,
        "n_eval": 100,
        "n_epochs": 1,
        "max_steps": 30,
        "rationale": "T2 only needs enough training to produce a real checkpoint to test the post-training plumbing against (baseline eval, post-train eval, inference, hub push, rerun-skill emission). max_steps=30 is plenty — convergence quality is NOT graded at T2. Use these knobs (NOT the full n_train/n_epochs above) for the T2 run."
      },
      "paper": {
        "title": "ConvNeXt V2: Co-designing and Scaling ConvNets with Masked Autoencoders",
        "authors": "Woo, Debnath, Hu, Chen, Liu, Kweon, Xie",
        "venue": "CVPR 2023",
        "arxiv": "https://arxiv.org/abs/2301.00808",
        "headline_result": "ConvNeXt-V2-Tiny pretrained on ImageNet-1k @ 224: 82.6% top-1 accuracy",
        "table_reference": "Table 1 (ImageNet-1k); downstream fine-tunes in Table 7 reach 91-93% on small datasets like Food101 / CIFAR-100"
      },
      "tier_thresholds": {
        "T3_primary_metric": "accuracy",
        "T3_target": 0.80,
        "T3_min_improvement_over_baseline": 0.20,
        "T3_rationale": "Food101 with ConvNeXt-V2-Tiny on a 6k-image subset for 3 epochs typically reaches 0.82-0.88 top-1; the paper reports ~0.93 on full Food101. 0.80 is the smoke-budget floor."
      },
      "prompt": "Run the tao-hf-finetune skill end-to-end for the following:\n\n- model_id: `facebook/convnextv2-tiny-1k-224`\n- dataset_id: `food101`\n- task_type: image-classification\n- n_train: 6000, n_eval: 1500, n_epochs: 3\n- output_dir: ./output/convnextv2_tiny_food101\n- push_to_hub: true (auto-derive repo from HF_TOKEN whoami)\n- emit_progress_log: true\n\nThe skill is at `/Users/hqtran/Code/GitLab/TAO/tao-hf-skill/.claude/skills/tao-hf-finetune`. Read SKILL.md and follow the 6-step workflow exactly.\n\nCredentials are in ~/.skill-eval-credentials — source it before starting.\n\nThis is **medium difficulty**. Standard CV classification with ImageClassification head. Most failure modes are augmentation-related: ConvNeXt-V2 needs `RandomResizedCrop` + `RandomHorizontalFlip` + `RandAugment` to reach paper-level accuracy. Step 3 must research the actual transforms from the HF image-classification task doc; do NOT use only `AutoImageProcessor` (resize+normalize), which caps at ~57% on small datasets per the skill's error playbook.\n\n## Evaluation tiers\n\nReport pass/fail for each tier independently. Run T1 → T2 → T3 in order. T2 and T3 use DIFFERENT training budgets — see below.\n\n- **T1 — Pipeline functional**: project files, Docker build, 1-step smoke test pass.\n- **T2 — Post-training plumbing (short-budget checkpoint)**: re-run training with the `t2_smoke_config` knobs (n_train=200, n_eval=100, n_epochs=1, max_steps=30) — NOT the full config above. Don't run a full epoch. The training itself only needs to produce a real checkpoint; convergence quality is NOT graded at T2. The pass condition is that every phase past training works end-to-end against that checkpoint: baseline eval (run_eval.py on the pretrained checkpoint), post-train eval (run_eval.py on checkpoints/final), 5 inference samples (infer.py), HF Hub push (auth, repo creation, model card, results subfolder), and rerun-skill emission (output/.../skills/run-<short>/SKILL.md with NO literal <placeholder> strings and real paths to the just-created checkpoint). Final accuracy is graded at T3.\n- **T3 — P1 paper accuracy (full training)**: re-run training with the FULL configured budget (n_train=6000, n_eval=1500, n_epochs=3) and check post-train accuracy ≥ 0.80 top-1 on food101 eval split with ≥ 0.20 absolute improvement over baseline. Paper reference: ConvNeXt-V2-Tiny @ ImageNet-1k 82.6% (arxiv 2301.00808 Table 1); downstream Food101 fine-tunes in Table 7 reach ~93%. Do NOT skip T3 due to expected runtime — a 60+ minute training run is expected and required.\n\n## Done\n\nReturn a JSON block to stdout:\n```json\n{\n  \"eval_id\": \"tao-hf-finetune/convnextv2-tiny-food101\",\n  \"T1_pipeline_functional\": <true|false>,\n  \"T2_pipeline_completes\":  <true|false>,\n  \"T3_paper_accuracy\":      <true|false>,\n  \"baseline_accuracy\": <float>,\n  \"finetuned_accuracy\": <float>,\n  \"hf_hub_url\": \"<URL>\",\n  \"wandb_url\":  \"<URL>\",\n  \"rerun_skill_path\": \"<path>\",\n  \"failure_summary\": \"<empty if all pass; else short reason>\"\n}\n```",
      "expected_outcome": "All three tiers pass. T1: project files, Docker build, 1-step smoke OK. T2 (t2_smoke_config knobs, ~30 steps): every post-training phase works against a real checkpoint — checkpoint loadable, baseline + post-train eval JSONs with numeric values, 5 inference samples, HF Hub push succeeds, rerun skill SKILL.md emitted with no <placeholder> strings. Convergence quality and final accuracy are NOT graded at T2. T3 (full configured budget): baseline_accuracy near random (~0.01-0.05), finetuned_accuracy ≥ 0.80. HF Hub URL points at <whoami>/convnextv2-tiny-1k-224-finetuned. Rerun skill at output/convnextv2_tiny_food101/skills/run-convnextv2-tiny-1k-224/SKILL.md."
    },
    {
      "id": "tao-hf-finetune/deformable-detr-cppe5",
      "difficulty": "medium-hard",
      "task": "object-detection",
      "model_id": "SenseTime/deformable-detr",
      "dataset_id": "cppe-5",
      "n_train": 1000,
      "n_eval": 29,
      "n_epochs": 30,
      "max_time_minutes": 90,
      "t2_smoke_config": {
        "n_train": 100,
        "n_eval": 29,
        "n_epochs": 1,
        "max_steps": 30,
        "rationale": "T2 only needs enough training to produce a real checkpoint to test the post-training plumbing against (baseline eval, post-train eval, inference, hub push, rerun-skill emission). max_steps=30 is plenty — convergence quality is NOT graded at T2. Use these knobs (NOT the full n_train/n_epochs above) for the T2 run."
      },
      "paper": {
        "title": "Deformable DETR: Deformable Transformers for End-to-End Object Detection",
        "authors": "Zhu, Su, Lu, Li, Wang, Dai",
        "venue": "ICLR 2021",
        "arxiv": "https://arxiv.org/abs/2010.04159",
        "headline_result": "Deformable DETR (ResNet-50 backbone): 43.8 AP on COCO val2017 at 50 epochs",
        "table_reference": "Table 1 — COCO val2017; small-dataset fine-tunes (CPPE-5, ~1k images) typically hit 0.30-0.45 mAP@[0.5:0.95]"
      },
      "tier_thresholds": {
        "T3_primary_metric": "map",
        "T3_target": 0.25,
        "T3_min_improvement_over_baseline": 0.20,
        "T3_rationale": "CPPE-5 (5 classes, 1029 train / 29 eval images) for 30 epochs at bs=4 on Deformable DETR R-50 typically reaches 0.30-0.40 mAP. 0.25 is the smoke-budget floor; baseline (zero-shot pretrained on COCO) is essentially 0 mAP because COCO classes don't match CPPE-5's medical-PPE classes."
      },
      "prompt": "Run the tao-hf-finetune skill end-to-end for the following:\n\n- model_id: `SenseTime/deformable-detr`\n- dataset_id: `cppe-5`\n- task_type: object-detection\n- n_train: 1000, n_eval: 29, n_epochs: 30\n- output_dir: ./output/deformable_detr_cppe5\n- push_to_hub: true (auto-derive repo)\n- emit_progress_log: true\n\nThe skill is at `/Users/hqtran/Code/GitLab/TAO/tao-hf-skill/.claude/skills/tao-hf-finetune`. Read SKILL.md and follow the 6-step workflow exactly.\n\nCredentials are in ~/.skill-eval-credentials — source it before starting.\n\nThis is **medium-hard**. Detection models have non-trivial collators (variable bbox counts), the COCO-format `objects.bbox` + `objects.category` schema, and metric pitfalls. Specific gotchas the skill's error playbook flags for this combo:\n- Albumentations `y_max <= y_min` on CPPE-5 — requires `filter_invalid_bboxes=True, min_area=1` in `A.BboxParams`.\n- Detection compute_metrics during eval: do NOT use `eval_do_concat_batches=False` with in-trainer mAP. Use `metric_for_best_model=eval_loss` during training and run mAP standalone via run_eval.py.\n- bf16: load fp32, only set `bf16=True` in TrainingArguments — Deformable DETR's deformable-attn kernel is finicky in bf16 weights.\n\nStep 3 research must extract the train/eval transforms from the HF object-detection task doc (Albumentations-based, with `category_ids` mapping) and the Deformable DETR collator (image_processor.pad).\n\n## Evaluation tiers\n\nReport pass/fail for each tier independently. Run T1 → T2 → T3 in order. T2 and T3 use DIFFERENT training budgets.\n\n- **T1 — Pipeline functional**: project files, Docker build, 1-step smoke test pass.\n- **T2 — Post-training plumbing (short-budget checkpoint)**: re-run training with the `t2_smoke_config` knobs (n_train=100, n_eval=29, n_epochs=1, max_steps=30) — NOT the full config above. The training itself only needs to produce a real checkpoint; convergence quality is NOT graded at T2. The pass condition is that every phase past training works end-to-end against that checkpoint: baseline eval (run_eval.py on the pretrained checkpoint), post-train eval (run_eval.py on checkpoints/final), 5 inference samples (infer.py — bbox overlays), HF Hub push, and rerun-skill emission with no <placeholder> strings. mAP is graded at T3.\n- **T3 — P1 paper accuracy (full training)**: re-run training with the FULL configured budget (n_train=1000, n_eval=29, n_epochs=30) and check post-train mAP@[0.5:0.95] ≥ 0.25 on CPPE-5 eval split with ≥ 0.20 absolute improvement over baseline. Paper reference: Deformable DETR R-50 @ COCO val2017 43.8 AP (arxiv 2010.04159 Table 1). Do NOT skip T3 due to expected runtime.\n\n## Done\n\nReturn a JSON block to stdout:\n```json\n{\n  \"eval_id\": \"tao-hf-finetune/deformable-detr-cppe5\",\n  \"T1_pipeline_functional\": <true|false>,\n  \"T2_pipeline_completes\":  <true|false>,\n  \"T3_paper_accuracy\":      <true|false>,\n  \"baseline_map\": <float>,\n  \"finetuned_map\": <float>,\n  \"hf_hub_url\": \"<URL>\",\n  \"wandb_url\":  \"<URL>\",\n  \"rerun_skill_path\": \"<path>\",\n  \"failure_summary\": \"<empty if all pass; else short reason>\"\n}\n```",
      "expected_outcome": "All three tiers pass. T1: project files, Docker build, 1-step smoke OK. T2 (t2_smoke_config knobs, ~30 steps): every post-training phase works against a real checkpoint — checkpoint loadable, baseline + post-train eval JSONs with numeric values, 5 inference samples (bbox overlays), HF Hub push succeeds, rerun skill SKILL.md emitted with no <placeholder> strings. Convergence quality and final mAP are NOT graded at T2. T3 (full configured budget): baseline_map near 0 (COCO pretraining doesn't transfer to CPPE-5 medical PPE classes), finetuned_map ≥ 0.25. HF Hub URL at <whoami>/deformable-detr-finetuned. Rerun skill at output/deformable_detr_cppe5/skills/run-deformable-detr/SKILL.md."
    },
    {
      "id": "tao-hf-finetune/mask2former-swin-tiny-foodseg",
      "difficulty": "hard",
      "task": "semantic-segmentation",
      "model_id": "facebook/mask2former-swin-tiny-ade-semantic",
      "dataset_id": "EduardoPacheco/FoodSeg103",
      "n_train": 4000,
      "n_eval": 1000,
      "n_epochs": 5,
      "max_time_minutes": 120,
      "t2_smoke_config": {
        "n_train": 200,
        "n_eval": 100,
        "n_epochs": 1,
        "max_steps": 30,
        "rationale": "T2 only needs enough training to produce a real checkpoint to test the post-training plumbing against (baseline eval, post-train eval, inference, hub push, rerun-skill emission). max_steps=30 is plenty — convergence quality is NOT graded at T2. Use these knobs (NOT the full n_train/n_epochs above) for the T2 run."
      },
      "paper": {
        "title": "Masked-attention Mask Transformer for Universal Image Segmentation",
        "authors": "Cheng, Misra, Schwing, Kirillov, Girdhar",
        "venue": "CVPR 2022",
        "arxiv": "https://arxiv.org/abs/2112.01527",
        "headline_result": "Mask2Former Swin-T on ADE20K semantic seg: 47.7 mIoU @ single-scale (47.2 in earlier table)",
        "table_reference": "Table 4 (ADE20K val); a 4k-image fine-tune to FoodSeg103 (104 classes) for 5 epochs typically reaches 0.30-0.45 mIoU"
      },
      "tier_thresholds": {
        "T3_primary_metric": "mean_iou",
        "T3_target": 0.25,
        "T3_min_improvement_over_baseline": 0.20,
        "T3_rationale": "FoodSeg103 (104 classes including background) is very far from ADE20K's class set; baseline ~0.02-0.05 mIoU. After 5 epochs on 4k images at bs=4, Mask2Former-Swin-T typically reaches 0.30-0.40 mIoU. 0.25 is the smoke-budget floor."
      },
      "prompt": "Run the tao-hf-finetune skill end-to-end for the following:\n\n- model_id: `facebook/mask2former-swin-tiny-ade-semantic`\n- dataset_id: `EduardoPacheco/FoodSeg103`\n- task_type: semantic-segmentation\n- n_train: 4000, n_eval: 1000, n_epochs: 5\n- output_dir: ./output/mask2former_swin_tiny_foodseg\n- push_to_hub: true (auto-derive repo)\n- emit_progress_log: true\n\nThe skill is at `/Users/hqtran/Code/GitLab/TAO/tao-hf-skill/.claude/skills/tao-hf-finetune`. Read SKILL.md and follow the 6-step workflow exactly.\n\nCredentials are in ~/.skill-eval-credentials — source it before starting.\n\nThis is **hard**. Mask2Former is a query-based universal segmentation architecture — the output structure (class_queries_logits + masks_queries_logits) is very different from SegFormer's per-pixel logits. Step 3 research must cover:\n- The Mask2Former image processor (`Mask2FormerImageProcessor`) which produces `pixel_values`, `pixel_mask`, `mask_labels`, and `class_labels` per-image (variable instance count → custom collator required).\n- The semantic-seg post-processing path: `image_processor.post_process_semantic_segmentation` to convert (class_queries, mask_queries) → per-pixel labels.\n- `id2label` must be re-initialized for FoodSeg103 (104 classes, ADE20K head is 150). This means `ignore_mismatched_sizes=True` on `from_pretrained`.\n\nGotchas the skill's error playbook flags:\n- Per-instance variable shapes mean a uniform-batch test will pass but heterogeneous batches break — emit_unit_tests=true is recommended for this eval.\n- Mask2Former's auxiliary loss requires deep supervision; do not strip outputs at intermediate decoder layers.\n- bf16: load fp32, only set `bf16=True` in TrainingArguments.\n\n## Evaluation tiers\n\nReport pass/fail for each tier independently. Run T1 → T2 → T3 in order. T2 and T3 use DIFFERENT training budgets.\n\n- **T1 — Pipeline functional**: project files, Docker build, 1-step smoke test pass.\n- **T2 — Post-training plumbing (short-budget checkpoint)**: re-run training with the `t2_smoke_config` knobs (n_train=200, n_eval=100, n_epochs=1, max_steps=30) — NOT the full config above. The training itself only needs to produce a real checkpoint; convergence quality is NOT graded at T2. The pass condition is that every phase past training works end-to-end against that checkpoint: baseline eval (run_eval.py on the pretrained checkpoint), post-train eval (run_eval.py on checkpoints/final), 5 inference samples (infer.py — segmentation overlays), HF Hub push, and rerun-skill emission with no <placeholder> strings. mIoU is graded at T3.\n- **T3 — P1 paper accuracy (full training)**: re-run training with the FULL configured budget (n_train=4000, n_eval=1000, n_epochs=5) and check post-train mean_iou ≥ 0.25 on FoodSeg103 eval split with ≥ 0.20 absolute improvement over baseline. Paper reference: Mask2Former Swin-T @ ADE20K 47.7 mIoU single-scale (arxiv 2112.01527 Table 4). Do NOT skip T3 due to expected runtime.\n\n## Done\n\nReturn a JSON block to stdout:\n```json\n{\n  \"eval_id\": \"tao-hf-finetune/mask2former-swin-tiny-foodseg\",\n  \"T1_pipeline_functional\": <true|false>,\n  \"T2_pipeline_completes\":  <true|false>,\n  \"T3_paper_accuracy\":      <true|false>,\n  \"baseline_mean_iou\": <float>,\n  \"finetuned_mean_iou\": <float>,\n  \"hf_hub_url\": \"<URL>\",\n  \"wandb_url\":  \"<URL>\",\n  \"rerun_skill_path\": \"<path>\",\n  \"failure_summary\": \"<empty if all pass; else short reason>\"\n}\n```",
      "expected_outcome": "All three tiers pass. T1: project files, Docker build, 1-step smoke OK. T2 (t2_smoke_config knobs, ~30 steps): every post-training phase works against a real checkpoint — checkpoint loadable, baseline + post-train eval JSONs with numeric values, 5 inference samples (segmentation overlays), HF Hub push succeeds, rerun skill SKILL.md emitted with no <placeholder> strings. Convergence quality and final mIoU are NOT graded at T2. T3 (full configured budget): baseline_mean_iou ~0.02-0.05 (ADE20K class set doesn't transfer), finetuned_mean_iou ≥ 0.25. HF Hub URL at <whoami>/mask2former-swin-tiny-ade-semantic-finetuned. Rerun skill at output/mask2former_swin_tiny_foodseg/skills/run-mask2former-swin-tiny-ade-semantic/SKILL.md."
    }
  ],
  "scoring": {
    "per_eval_score": "0/3 (no tier passed) → 3/3 (all tiers passed)",
    "skill_score": "Sum of per_eval_score across all evals, max 9",
    "headline_metric": "fraction of T1+T2+T3 boxes ticked across the 3 evals (denominator 9)",
    "tier_weights": {
      "T1_pipeline_functional": 1.0,
      "T2_pipeline_completes": 1.0,
      "T3_paper_accuracy": 1.0
    },
    "interpretation": {
      "9/9": "skill produces correct, complete, and paper-faithful pipelines for all 3 difficulty levels",
      "6-8/9": "skill is robust on T1+T2 but accuracy is below paper baselines on at least one model — likely missing augmentations or recipe drift",
      "3-5/9": "skill generates code but pipelines fail to complete — likely API drift, compat issues, or incorrect collator",
      "0-2/9": "skill cannot produce a functional pipeline for the medium case — investigate Step 4 generation"
    }
  }
}
